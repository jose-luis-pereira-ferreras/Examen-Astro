---
import { SITE_TITLE } from '../site.config';

const nav = [
  { label: 'Inicio', href: '/' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Quienes somos', href: '/quienes-somos' },
  { label: 'Blog', href: '/blog' },
];
---
<header class="header">
  <div class="header-inner">
    <a href="/" class="brand">{SITE_TITLE}</a>
    <input type="checkbox" id="menu-toggle" aria-label="Abrir el menú de navegación" />
    <label class="menu-toggle" for="menu-toggle">☰</label>
    <nav class="nav">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href="/cta" class="header-cta">Conoce nuestros cursos</a>
  </div>
</header>
