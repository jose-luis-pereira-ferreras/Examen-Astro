---
import { SITE_TITLE, BASE_URL } from '../site.config';

const nav = [
  { label: 'Inicio', href: BASE_URL },
  { label: 'Servicios', href: `${BASE_URL}#servicios` },
  { label: 'Quienes somos', href: `${BASE_URL}quienes-somos` },
  { label: 'Blog', href: `${BASE_URL}blog` },
];
---
<header class="header">
  <div class="header-inner">
    <a href={BASE_URL} class="brand">{SITE_TITLE}</a>
    <input type="checkbox" id="menu-toggle" aria-label="Abrir el menú de navegación" />
    <label class="menu-toggle" for="menu-toggle">☰</label>
    <nav class="nav">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a href={`${BASE_URL}cta`} class="header-cta">Conoce nuestros cursos</a>
  </div>
</header>
