---
import { BASE_URL } from '../site.config';

interface Props {
  name: string;
  role: string;
  bio?: string;
  photo?: string;
}

const { name, role, bio, photo = `${BASE_URL}img/team/team.svg` } = Astro.props;
---
<div class="team-card">
  <img class="team-photo" src={photo} alt={name} />
  <h3>{name}</h3>
  <p class="team-role">{role}</p>
  {bio && <p>{bio}</p>}
</div>
