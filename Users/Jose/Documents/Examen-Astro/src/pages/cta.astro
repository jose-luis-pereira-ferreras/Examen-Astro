---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Llamada a la acción - Academia Lumen"
  description="Conoce los cursos disponibles de Academia Lumen y solicita información para reservar tu cupo."
>
  <section class="cta-form">
    <h1>Conoce nuestros cursos y reserva tu cupo</h1>
    <p>
      Escríbenos tu nombre, correo y mensaje, y nos pondremos en contacto con
      información sobre los cursos disponibles.
    </p>

    <!-- Reemplaza la URL de Formspree por la de tu propio formulario procesador -->
    <form action="https://formspree.io/f/xxxxxx" method="POST">
      <label>
        Nombre
        <input type="text" name="nombre" required placeholder="Tu nombre" />
      </label>
      <label>
        Email
        <input type="email" name="email" required placeholder="tu@email.com" />
      </label>
      <label>
        Teléfono
        <input type="tel" name="telefono" placeholder="Opcional" />
      </label>
      <label>
        Mensaje
        <textarea name="mensaje" rows="4" required placeholder="¿Qué te interesa saber?"></textarea>
      </label>
      <button type="submit">Enviar mensaje</button>
    </form>
  </section>
</BaseLayout>
